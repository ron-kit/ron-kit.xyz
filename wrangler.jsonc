{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ron-kit-xyz",
  "compatibility_date": "2026-10-06",
  "build": { "command": "./build.sh" },
  "dev": { "port": 8000 },
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "ron-kit.xyz", "custom_domain": true },
    { "pattern": "www.ron-kit.xyz", "custom_domain": true }
  ],
  "assets": {
    "directory": "./site"
  }
}
